NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.example
DATABASE_URL=postgresql://aniwatch:change-me@db:5432/aniwatch?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters

# PayPal merchant integration.
# Use sandbox while testing. Change to live only when ready.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID=
PAYPAL_SUBSCRIPTION_NAME=AniWatch Premium
PAYPAL_SUBSCRIPTION_PRICE=4.99
PAYPAL_CURRENCY=USD
PAYPAL_AUTO_SETUP=true

# Ads are automatically hidden for active Premium subscribers.
ADS_ENABLED=true
ADS_PROVIDER=adsterra
ADSTERRA_HEADER_KEY=
ADSTERRA_RECTANGLE_KEY=
ADSTERRA_SIDEBAR_KEY=
